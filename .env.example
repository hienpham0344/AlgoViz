# Used by docker-compose.yml. Copy to .env (git-ignored) and fill in the values.

# Required. At least 32 characters. Generate: openssl rand -hex 32
ALGOVIZ_JWT_SECRET=

# Host port that serves the app (container port is always 8080).
ALGOVIZ_PORT=8080

# Origins allowed by CORS. The bundled UI is same-origin, so the default is enough.
ALGOVIZ_CORS_ALLOWED_ORIGINS=http://localhost:8080

# Leave the SPRING_* values empty/default to use in-memory H2 (data is lost on restart).
# For PostgreSQL (`docker compose --profile postgres up`), set all of them:
# POSTGRES_PASSWORD=
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/algoviz
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
# SPRING_DATASOURCE_USERNAME=algoviz
# SPRING_DATASOURCE_PASSWORD=
