{
  "manifest_version": 3,
  "name": "AlgoViz Side Panel & Code Bridge",
  "version": "1.0.0",
  "description": "Step through live Java AST/JDI runtime traces, visualize arrays and pointers, and run multi-language code alongside Wecode UIT and LeetCode.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "http://localhost:5173/*",
    "https://*.azurecontainerapps.io/*",
    "https://leetcode.com/*",
    "https://*.uit.edu.vn/*",
    "https://*.geeksforgeeks.org/*"
  ],
  "action": {
    "default_title": "Open AlgoViz Trace Side Panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://*.uit.edu.vn/*",
        "https://*.geeksforgeeks.org/*"
      ],
      "js": [
        "content/code-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
