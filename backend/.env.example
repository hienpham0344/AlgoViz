# Cấu hình problem knowledge-base importer
ALGOVIZ_IMPORT_ENABLED=
ALGOVIZ_IMPORT_SOURCE=
ALGOVIZ_PROBLEMS_FILE=
ALGOVIZ_SOLUTIONS_FILE=
ALGOVIZ_MOCK_DATA_DIRECTORY=
