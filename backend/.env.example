# Kết nối PostgreSQL của Supabase
# All user code runs in Docker. Host interpreter settings are no longer used.
# ALGOVIZ_DOCKER_COMMAND=docker
# ALGOVIZ_SANDBOX_IMAGE=algoviz-runner:local
SPRING_DATASOURCE_URL=
